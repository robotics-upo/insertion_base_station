<launch>

    <node pkg="rviz2" exec="rviz2" args="-d $(find-pkg-share insertion_base_station)/cfg/base_station.rviz"/>

    <node pkg="insertion_base_station" exec="gps_publisher.py" name="takeoff_gps_publisher" output="screen">
        <param name="latitude" value="39.7942581176758"/>
        <param name="longitude" value="-4.08134603500366"/>
        <param name="altitude" value="0.0"/>
        <remap from="/gps/fix" to="/takeoff_gps" />
        <param name="publish_rate" value="1.0"/>
    </node>

    <node pkg="upo_markers" exec="marker_node" name="drone2_marker_node" output="screen">
        <param name="publish_tf" value="true"/>
        <param name="frame_id" value="drone2/base_link"/>
    </node>

    <node pkg="insertion_base_station" exec="global_to_local" name="global_to_local_node" output="screen">
        <remap from="/fix" to="/takeoff_gps"/>
        <remap from="/gps" to="/drone2/dji_sdk/gps_position"/>
        <param name="base_frame" value="drone2/base_link"/>
    </node>

</launch>