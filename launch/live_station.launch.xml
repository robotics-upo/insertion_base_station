<launch>
    <!-- PARAMS: GeographicLib Origin -->
    <arg name="origin_lat" default="39.7942581176758"/>
    <arg name="origin_lon" default="-4.08134603500366"/>
    <arg name="origin_alt" default="536.3"/>

    <!-- PARAMS: Timers -->
    <arg name="battery_timeout_ms" default="5000"/>
    <arg name="status_timeout_ms" default="3000"/>
    <arg name="tf_timeout_sec" default="2.0"/>
    <arg name="default_flight_alt" default="20.0"/>
    <arg name="min_safe_alt" default="5.0"/>

    <!-- GPS Publisher -->
    <node pkg="insertion_base_station" exec="gps_publisher.py" name="takeoff_gps_publisher" output="screen">
        <param name="latitude" value="$(var origin_lat)"/>
        <param name="longitude" value="$(var origin_lon)"/>
        <param name="altitude" value="$(var origin_alt)"/>
        <param name="publish_rate" value="20.0"/>
        <remap from="/gps/fix" to="/takeoff_gps" />
    </node>

    <!-- Static Tf -->
    <node pkg="tf2_ros" exec="static_transform_publisher" name="map_to_gps_tf" output="screen"
        args="0 0 0 0 0 0 map gps"/>

    <!-- Camera Mux -->
    <node pkg="insertion_base_station" exec="camera_mux.py" name="camera_multiplexer" output="screen"/>
    
    <!-- Tags -->
    <node pkg="insertion_base_station" exec="asset_labels.py" name="asset_labels" output="screen"/>
    
    <!-- RVIZ2 -->
    <node pkg="rviz2" exec="rviz2" name="rviz2" args="-d $(find-pkg-share insertion_base_station)/cfg/base_station.rviz">
        <param name="origin_lat" value="$(var origin_lat)"/>
        <param name="origin_lon" value="$(var origin_lon)"/>
        <param name="origin_alt" value="$(var origin_alt)"/>
        
        <param name="battery_timeout_ms" value="$(var battery_timeout_ms)"/>
        <param name="status_timeout_ms" value="$(var status_timeout_ms)"/>
        <param name="tf_timeout_sec" value="$(var tf_timeout_sec)"/>
        
        <param name="default_flight_alt" value="$(var default_flight_alt)"/>
        <param name="min_safe_alt" value="$(var min_safe_alt)"/>
    </node>
    
    <!-- DRONE 1 CONFIG -->
    <arg name="drone1_ns" default="/drone1"/>
    <arg name="drone1_frame" default="drone1/base_link"/>

    <node pkg="insertion_base_station" exec="global_to_local" name="global_to_local_node_drone1" output="screen">
        <remap from="/fix" to="/takeoff_gps"/>
        <remap from="/gps" to="$(var drone1_ns)/dji_sdk/gps_position"/>
        <param name="attitude_topic" value="$(var drone1_ns)/dji_sdk/attitude"/>
        <param name="base_frame" value="$(var drone1_frame)"/>
        <param name="path_topic" value="$(var drone1_ns)/path"/>
        <param name="z_offset" value="0.5"/>
        <param name="relative_z" value="true"/>
    </node>

    <node pkg="insertion_base_station" exec="radar_converter.py" name="radar_rcs_node_drone1" output="screen">
        <remap from="/radar/PointCloudDetection" to="$(var drone1_ns)/radar/PointCloudDetection"/>
        <remap from="/radar/classified_cloud" to="$(var drone1_ns)/radar/classified_cloud"/>
        <param name="output_frame" value="drone1/ARS_548"/>
        <param name="rcs_water_limit" value="-20.0"/>
        <param name="rcs_land_limit" value="-6.0"/>  
        <param name="min_distance_filter" value="3.0"/>
    </node>
    
    <node pkg="tf2_ros" exec="static_transform_publisher" name="tf_drone1_to_radar" output="screen"
        args="0 0 0 0 0 0 /drone1/base_link drone1/ARS_548"/>

    <node pkg="insertion_base_station" exec="camera_fix.py" name="camera_decoder_drone1" output="screen">
        <remap from="/camera/color/image_raw/compressed" to="$(var drone1_ns)/camera/color/image_raw/compressed"/>
        <remap from="/camera/final_image" to="$(var drone1_ns)/camera/final_image"/>
        <param name="output_frame" value="drone1/camera_link"/>
    </node>

    <node pkg="upo_markers" exec="marker_node" name="drone1_marker_node" output="screen">
        <param name="publish_tf" value="true"/>
        <param name="frame_id" value="$(var drone1_frame)"/>
        <remap from="/upo_marker" to="$(var drone1_ns)/marker"/>
    </node>

    <!-- DRONE 2 CONFIG -->
    <arg name="drone2_ns" default="/drone2"/>
    <arg name="drone2_frame" default="drone2/base_link"/>

    <node pkg="insertion_base_station" exec="global_to_local" name="global_to_local_node_drone2" output="screen">
        <remap from="/fix" to="/takeoff_gps"/>
        <remap from="/gps" to="$(var drone2_ns)/dji_sdk/gps_position"/>
        <param name="attitude_topic" value="$(var drone2_ns)/dji_sdk/attitude"/>
        <param name="base_frame" value="$(var drone2_frame)"/>
        <param name="path_topic" value="$(var drone2_ns)/path"/>
        <param name="z_offset" value="0.5"/>
        <param name="relative_z" value="true"/>
    </node>

    <node pkg="insertion_base_station" exec="radar_converter.py" name="radar_rcs_node_drone2" output="screen">
        <remap from="/radar/PointCloudDetection" to="$(var drone2_ns)/radar/PointCloudDetection"/>
        <remap from="/radar/classified_cloud" to="$(var drone2_ns)/radar/classified_cloud"/>
        <param name="output_frame" value="drone2/ARS_548"/>
        <param name="rcs_water_limit" value="-20.0"/>
        <param name="rcs_land_limit" value="-6.0"/>  
        <param name="min_distance_filter" value="3.0"/>
    </node>

    <node pkg="tf2_ros" exec="static_transform_publisher" name="tf_drone2_to_radar" output="screen" 
        args="0 0 0 0 0 0 /drone2/base_link drone2/ARS_548"/>

    <node pkg="insertion_base_station" exec="camera_fix.py" name="camera_decoder_drone2" output="screen">
        <remap from="/camera/color/image_raw/compressed" to="$(var drone2_ns)/camera/color/image_raw/compressed"/>
        <remap from="/camera/final_image" to="$(var drone2_ns)/camera/final_image"/>
        <param name="output_frame" value="drone2/camera_link"/>
    </node>

    <node pkg="upo_markers" exec="marker_node" name="drone2_marker_node" output="screen">
        <param name="publish_tf" value="true"/>
        <param name="frame_id" value="$(var drone2_frame)"/>
        <remap from="/upo_marker" to="$(var drone2_ns)/marker"/> 
    </node>

    <!-- BOAT CONFIG -->
    <node pkg="insertion_base_station" exec="global_to_local" name="boat_global_to_local_node" output="screen">
        <remap from="/fix" to="/takeoff_gps"/>
        <remap from="/gps" to="/boat_gps"/>
        <param name="base_frame" value="boat/base_link"/>
        <param name="path_topic" value="boat/path"/>
        <param name="use_z" value="false"/>
        <param name="relative_z" value="true"/>
    </node>

    <node pkg="upo_markers" exec="marker_node" name="boat_marker_node" output="screen">
        <param name="publish_tf" value="true"/>
        <param name="frame_id" value="boat/base_link"/>
        <param name="model" value="circle"/>
        <param name="ns" value="boat_marker"/>
        <param name="radius" value="2.0"/>
        <param name="r" value="0.0"/>
        <param name="g" value="1.0"/>
        <param name="b" value="1.0"/>
        <param name="a" value="0.8"/>
        <remap from="/upo_marker" to="/boat_marker"/>
    </node>

</launch>