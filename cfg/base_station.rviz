Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Drone1_radar1/Topic1
        - /Drone2_radar1/Topic1
        - /Drone_image1/Topic1
        - /Tags1/Topic1
        - /Tags1/Namespaces1
      Splitter Ratio: 0.5
    Tree Height: 174
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: ""
  - Class: insertion_base_station/MissionPanel
    Name: MissionPanel
  - Class: insertion_base_station/BatteryPanel
    Name: BatteryPanel
  - Class: insertion_base_station/FlightPanel
    Name: FlightPanel
  - Class: insertion_base_station/LayerPanel
    Name: LayerPanel
  - Class: insertion_base_station/LayerPanel
    Name: LayerPanel
